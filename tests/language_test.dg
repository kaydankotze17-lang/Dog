fn add(a: number, b: number) -> number
    return a + b
end

assert(add(2, 3) == 5, "add should sum two numbers")
assert(lower("DOG") == "dog", "lower() must lowercase text")
assert(upper("dog") == "DOG", "upper() must uppercase text")
assert(number("42") == 42, "number() must parse integers")
assert(decimal("3.5") == 3.5, "decimal() must parse floats")

var tags: list<text> = []
push(tags, "rust")
push(tags, "termux")
assert(len(tags) == 2, "push() must append items")
assert(join(tags, ",") == "rust,termux", "join() must join text lists")
assert(pop(tags) == "termux", "pop() must return last element")
assert(len(tags) == 1, "pop() must remove last element")

enum Status
    Active
    Paused
end

struct Task
    title: text
    priority: number
    status: Status
end

var t = Task { title: "Ship DOG", priority: 1, status: Status.Active }
t.priority = 2
assert(t.priority == 2, "struct field mutation works")

var matched = ""
match t.status
    case Status.Active
        matched = "active"
    otherwise
        matched = "other"
end
assert(matched == "active", "match/case works for enums")

var scores: map<text, number> = {}
map_set(scores, "ada", 100)
assert(map_has(scores, "ada"), "map_has detects inserted key")
assert(map_get(scores, "ada") == 100, "map_get returns value")
assert(map_remove(scores, "ada"), "map_remove deletes key")
assert(len(scores) == 0, "map length updates after remove")

let h = hex_encode("dog")
assert(h == "646f67", "hex_encode matches ASCII bytes")
assert(hex_decode(h) == "dog", "hex_decode round-trips")

let b64 = base64_encode("hello")
assert(b64 == "aGVsbG8=", "base64_encode matches RFC 4648")
assert(base64_decode(b64) == "hello", "base64_decode round-trips")

assert(sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "SHA-256 matches NIST vector")

let parsed_json = json_parse("{\"tool\": \"dog\"}")
assert(map_get(parsed_json, "tool") == "dog", "json_parse reads keys")

var caught = false
try
    fail("expected boom")
catch err
    caught = contains(err, "expected boom")
end
assert(caught, "try/catch catches fail()")

assert(replace("hello dog", "dog", "world") == "hello world", "replace() substitutes text")
assert(starts_with("dog-lang", "dog"), "starts_with() checks prefix")
assert(ends_with("main.dg", ".dg"), "ends_with() checks suffix")
assert(slice("abcdef", 1, 4) == "bcd", "slice() extracts UTF-8 substring")

assert(round(3.6) == 4, "round() rounds to nearest integer")
assert(floor(3.9) == 3, "floor() rounds down")
assert(ceil(3.1) == 4, "ceil() rounds up")
assert(sqrt(9.0) == 3.0, "sqrt() computes square root")
assert(pow(2.0, 3.0) == 8.0, "pow() computes exponent")
let r = rand_int(1, 5)
assert(r >= 1 and r <= 5, "rand_int() stays within inclusive bounds")

let seq = range(1, 4)
assert(len(seq) == 3 and seq[0] == 1 and seq[2] == 3, "range() builds numeric list")
var nums = [30, 10, 20]
sort(nums)
assert(nums[0] == 10 and nums[2] == 30, "sort() sorts list in place")
reverse(nums)
assert(nums[0] == 30 and nums[2] == 10, "reverse() reverses list in place")
assert(list_contains(nums, 20), "list_contains() finds matching element")
assert(hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac_sha256 matches RFC vector")
assert(len(cwd()) > 0, "cwd() returns non-empty path")

