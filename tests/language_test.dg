use "std.io"
use "std.text"
use "std.math"
use "std.files"
use "std.data"

fn add(a: number, b: number) -> number
    return a + b
end

assert(add(2, 3) == 5, "add should sum two numbers")
assert(lower("DOG") == "dog", "lower() must lowercase text")
assert(upper("dog") == "DOG", "upper() must uppercase text")
assert(number("42") == 42, "number() must parse integers")
assert(decimal("3.5") == 3.5, "decimal() must parse floats")

var tags: list<text> = []
push(tags, "rust")
push(tags, "termux")
assert(len(tags) == 2, "push() must append items")
assert(join(tags, ",") == "rust,termux", "join() must join text lists")
assert(pop(tags) == "termux", "pop() must return last element")
assert(len(tags) == 1, "pop() must remove last element")

enum Status
    Active
    Paused
end

struct Task
    title: text
    priority: number
    status: Status
end

var t = Task { title: "Ship DOG", priority: 1, status: Status.Active }
t.priority = 2
assert(t.priority == 2, "struct field mutation works")

var matched = ""
match t.status
    case Status.Active
        matched = "active"
    otherwise
        matched = "other"
end
assert(matched == "active", "match/case works for enums")

var scores: map<text, number> = {}
map_set(scores, "ada", 100)
assert(map_has(scores, "ada"), "map_has detects inserted key")
assert(map_get(scores, "ada") == 100, "map_get returns value")
assert(map_remove(scores, "ada"), "map_remove deletes key")
assert(len(scores) == 0, "map length updates after remove")

let h = hex_encode("dog")
assert(h == "646f67", "hex_encode matches ASCII bytes")
assert(hex_decode(h) == "dog", "hex_decode round-trips")

let b64 = base64_encode("hello")
assert(b64 == "aGVsbG8=", "base64_encode matches RFC 4648")
assert(base64_decode(b64) == "hello", "base64_decode round-trips")

assert(sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "SHA-256 matches NIST vector")

let parsed_json = json_parse("{\"tool\": \"dog\"}")
assert(map_get(parsed_json, "tool") == "dog", "json_parse reads keys")

var caught = false
try
    fail("expected boom")
catch err
    caught = contains(err, "expected boom")
end
assert(caught, "try/catch catches fail()")

assert(replace("hello dog", "dog", "world") == "hello world", "replace() substitutes text")
assert(starts_with("dog-lang", "dog"), "starts_with() checks prefix")
assert(ends_with("main.dg", ".dg"), "ends_with() checks suffix")
assert(slice("abcdef", 1, 4) == "bcd", "slice() extracts UTF-8 substring")

assert(round(3.6) == 4, "round() rounds to nearest integer")
assert(floor(3.9) == 3, "floor() rounds down")
assert(ceil(3.1) == 4, "ceil() rounds up")
assert(sqrt(9.0) == 3.0, "sqrt() computes square root")
assert(pow(2.0, 3.0) == 8.0, "pow() computes exponent")
let r = rand_int(1, 5)
assert(r >= 1 and r <= 5, "rand_int() stays within inclusive bounds")

let seq = range(1, 4)
assert(len(seq) == 3 and seq[0] == 1 and seq[2] == 3, "range() builds numeric list")
var nums = [30, 10, 20]
sort(nums)
assert(nums[0] == 10 and nums[2] == 30, "sort() sorts list in place")
reverse(nums)
assert(nums[0] == 30 and nums[2] == 10, "reverse() reverses list in place")
assert(list_contains(nums, 20), "list_contains() finds matching element")
assert(hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac_sha256 matches RFC vector")
assert(len(cwd()) > 0, "cwd() returns non-empty path")

assert(url_encode("hello dog & cat!") == "hello%20dog%20%26%20cat%21", "url_encode() escapes reserved chars")
assert(url_decode("hello%20dog+%26%20cat%21") == "hello dog & cat!", "url_decode() restores encoded text")

let rows = csv_parse("name,role\n\"Ada, Lovelace\",leader\nRex,scout\n")
assert(len(rows) == 3, "csv_parse() parses all lines")
assert(rows[1][0] == "Ada, Lovelace" and rows[1][1] == "leader", "csv_parse() handles quoted commas")

assert(len(os_name()) > 0 and len(os_arch()) > 0, "os_name() and os_arch() return platform info")
let uid = uuid_v4()
assert(len(uid) == 36 and slice(uid, 14, 15) == "4", "uuid_v4() formats RFC 4122 version 4 UUID")

let cmd_res = exec_cmd("echo dog-exec-ok")
assert(map_get(cmd_res, "code") == "0", "exec_cmd() captures exit code")
assert(trim(map_get(cmd_res, "stdout")) == "dog-exec-ok", "exec_cmd() captures stdout")

cli_theme("dracula")
cli_prefix("dog-test")
cli_timestamps(false)
cli_info("CLI output initialized")
cli_success("Checks green")
cli_progress("Suite", 2, 2)
cli_spinner(1, "Verifying")
let _color_ok: bool = cli_supports_color()
let _tty_ok: bool = cli_is_tty()
assert(_color_ok == true or _color_ok == false, "cli_supports_color returns bool")
assert(_tty_ok == true or _tty_ok == false, "cli_is_tty returns bool")

# Upgraded language ergonomics: $"..." interpolation, +=/-=/*=//=/%=, otherwise if
let target = "DOG"
var score = 10
score += 5
score -= 3
score *= 2
score /= 4
score %= 4
assert(score == 2, "compound numeric assignments work cleanly")

var greeting = $"Hi {target}"
greeting += $" v{1 + 1} {{literal}}"
assert(greeting == "Hi DOG v2 {literal}", "interpolated strings evaluate expressions and escape {{ }}")

var tier = ""
if score > 10
    tier = "high"
otherwise if score == 2
    tier = "mid"
otherwise
    tier = "low"
end
assert(tier == "mid", "otherwise if chain evaluates matching branch")

# Upgraded stdlib built-ins: crypto, text, lists, maps, math, time, JSON, URL, router
assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 matches FIPS 180-1 test vector")
assert(html_escape("<a href=\"x\">me & 'u'</a>") == "&lt;a href=&quot;x&quot;&gt;me &amp; &#39;u&#39;&lt;/a&gt;", "html_escape escapes HTML entities")
assert(index_of("hello dog", "dog") == 6 and index_of("hello", "xyz") == -1, "index_of works")
assert(glob_match("*.dg", "main.dg") and not glob_match("*.dg", "main.rs"), "glob_match matches wildcards")
assert(str_repeat("ab", 3) == "ababab", "str_repeat repeats text")
assert(pad_left("7", 3, "0") == "007" and pad_right("hi", 4, ".") == "hi..", "pad_left/pad_right pad strings")
assert(clamp(15, 0, 10) == 10 and clamp(-3, 0, 10) == 0, "clamp bounds integers")
assert(sin(0.0) == 0.0 and cos(0.0) == 1.0 and log(1.0) == 0.0, "sin/cos/log compute math functions")

var dyn_list = [1, 3]
insert_at(dyn_list, 1, 2)
assert(len(dyn_list) == 3 and dyn_list[1] == 2, "insert_at inserts at index")
assert(list_index_of(dyn_list, 3) == 2, "list_index_of finds item")
let sub_list = list_slice(dyn_list, 1, 3)
assert(len(sub_list) == 2 and sub_list[0] == 2 and sub_list[1] == 3, "list_slice returns sublist")
assert(remove_at(dyn_list, 1) == 2 and len(dyn_list) == 2, "remove_at removes and returns item")
clear(dyn_list)
assert(len(dyn_list) == 0, "clear empties list")

var m_a: map<text, text> = {}
map_set(m_a, "k1", "v1")
var m_b: map<text, text> = {}
map_set(m_b, "k2", "v2")
map_merge(m_a, m_b)
let m_vals = map_values(m_a)
assert(len(m_vals) == 2 and map_get(m_a, "k2") == "v2", "map_merge and map_values work")
map_clear(m_a)
assert(len(m_a) == 0, "map_clear empties map")

assert(contains(time_utc(), "T") and ends_with(time_utc(), "Z"), "time_utc formats ISO-8601 UTC")
assert(contains(json_pretty("{\"a\":1}"), "\n  \"a\": 1"), "json_pretty indents JSON")

let u = url_parse("http://127.0.0.1:8080/users/42?role=admin&mode=dev")
assert(map_get(u, "scheme") == "http" and map_get(u, "port") == "8080" and map_get(u, "path") == "/users/42", "url_parse extracts URL components")
let q_map = query_parse(map_get(u, "query"))
assert(map_get(q_map, "role") == "admin" and map_get(q_map, "mode") == "dev", "query_parse decodes query params")
assert(contains(query_stringify(q_map), "role=admin"), "query_stringify encodes params")

let route = http_route_match("/users/:id/files/*rest", "/users/42/files/docs/readme.md")
assert(map_get(route, "_matched") == "true" and map_get(route, "id") == "42" and map_get(route, "rest") == "docs/readme.md", "http_route_match extracts named and wildcard params")

# v0.2.x Literals & 43 Stdlib Upgrades
let million = 1_000_000
let hex_mask = 0xFF_00
let bin_flags = 0b1010_0101
let pi_approx = 3.14_15
assert(million == 1000000 and hex_mask == 65280 and bin_flags == 165 and pi_approx > 3.14, "digit separators, hex, and binary literals work")

let doc_block = """
hello
multiline
"""
assert(contains(doc_block, "hello\nmultiline"), "triple-quoted multi-line strings preserve newlines")

assert(char_at("DOG", 1) == "O", "char_at returns single char")
assert(last_index_of("banana", "na") == 4, "last_index_of finds last match")
assert(count_matches("abababa", "aba") == 2, "count_matches counts non-overlapping matches")
assert(remove_prefix("dog_cli", "dog_") == "cli", "remove_prefix strips prefix")
assert(remove_suffix("main.dg", ".dg") == "main", "remove_suffix strips suffix")
assert(title_case("hello dog-lang") == "Hello Dog-Lang", "title_case capitalizes words")
assert(reverse_text("bark") == "krab", "reverse_text reverses chars")
let text_lines = lines("a\nb\nc")
assert(len(text_lines) == 3 and text_lines[2] == "c", "lines splits text by line")

assert(tan(0.0) == 0.0 and atan2(0.0, 1.0) == 0.0 and exp(0.0) == 1.0, "tan/atan2/exp work")
assert(log10(100.0) == 2.0 and pow_int(2, 10) == 1024, "log10 and pow_int work")
assert(sign(-42) == -1 and sign(0) == 0 and sign(3.5) == 1, "sign works on numbers and decimals")
assert(gcd(48, 18) == 6 and lcm(12, 15) == 60, "gcd and lcm work")
assert(math_pi() > 3.14 and math_e() > 2.71, "math_pi and math_e return constants")

let raw_dups = [1, 2, 1, 3, 2, 4]
assert(len(list_unique(raw_dups)) == 4, "list_unique preserves unique order")
assert(len(list_take(raw_dups, 2)) == 2 and list_skip(raw_dups, 4)[0] == 2, "list_take and list_skip work")
let flat = list_flatten([[1, 2], [3, 4]])
assert(len(flat) == 4 and list_sum(flat) == 10 and list_avg(flat) == 2.5, "list_flatten/sum/avg work")
assert(len(list_concat([1, 2], [3])) == 3, "list_concat joins lists")

let zipped = map_from_lists(["a", "b"], [10, 20])
assert(map_get_or(zipped, "b", 0) == 20 and map_get_or(zipped, "z", 99) == 99, "map_from_lists and map_get_or work")

let csv_out = csv_stringify([["name", "note"], ["Ada", "hi, dog"]])
assert(contains(csv_out, "\"hi, dog\""), "csv_stringify quotes fields with commas")
assert(json_has_key("{\"ok\":true}", "ok") and not json_has_key("{\"ok\":true}", "missing"), "json_has_key inspects keys")

assert(path_dirname("dir/sub/file.dg") == "dir/sub" or path_dirname("dir/sub/file.dg") == "dir\\sub", "path_dirname works")
assert(path_basename("dir/sub/file.dg") == "file.dg" and path_ext("dir/sub/file.dg") == "dg", "path_basename/path_ext work")
assert(len(temp_dir()) > 0, "temp_dir returns path")

assert(len(sha512("abc")) == 128, "sha512 produces 128 hex chars")
let sig = hmac_sha256("sec", "payload")
assert(hmac_sha256_verify("sec", "payload", sig) and not hmac_sha256_verify("sec", "payload", "0000"), "hmac_sha256_verify validates MAC")
let b64u = base64_url_encode("hello?dog/1+2=")
assert(not contains(b64u, "=") and base64_url_decode(b64u) == "hello?dog/1+2=", "base64_url round-trips")
assert(len(rand_bytes_hex(16)) == 32, "rand_bytes_hex returns 2*N hex chars")
assert(http_status_text(200) == "OK" and http_status_text(404) == "Not Found", "http_status_text maps status codes")
assert(len(local_ip()) > 0, "local_ip returns an IPv4 string")

# v0.3.0 Modular std.*, default parameters, interactive formatting, TOML, time_format, cookies
use "std.io"
use "std.text"
use "std.math"
use "std.files"
use "std.data"

assert(std.text.upper("pack") == "PACK", "std.text.upper namespace call works")
assert(std.math.gcd(36, 24) == 12, "std.math.gcd namespace call works")
assert(std.files.basename("pkg/mod/app.dg") == "app.dg", "std.files.basename works")
assert(contains(std.files.join("alpha", "beta.dg"), "beta.dg"), "std.files.join works")
assert(std.data.json_has_key("{\"ok\":1}", "ok"), "std.data.json_has_key works")

fn greet_default(name: text, prefix: text = "Hello", excl: text = "!") -> text
    return $"{prefix}, {name}{excl}"
end

assert(greet_default("DOG") == "Hello, DOG!", "default params apply when omitted")
assert(greet_default("DOG", "Yo") == "Yo, DOG!", "partial override of default params works")
assert(greet_default("DOG", "Hi", "?") == "Hi, DOG?", "full args override all defaults")

fn scale_val(base: number, factor: number = 2 + 3) -> number
    return base * factor
end

assert(scale_val(4) == 20 and scale_val(4, 3) == 12, "expression default parameters work")

let cfg = toml_parse("[server]\nhost = \"127.0.0.1\"\nport = 8080 # inline comment\n")
assert(map_get(cfg, "server.host") == "127.0.0.1" and map_get(cfg, "server.port") == "8080", "toml_parse reads sections and strips comments")

assert(time_format(0, "%Y-%m-%d %H:%M:%S") == "1970-01-01 00:00:00", "time_format renders Unix epoch UTC cleanly")
assert(time_format(1700000000000, "%F") == "2023-11-14", "time_format %F formats YYYY-MM-DD")

let cookies = cookie_parse("session=abc123; theme=kali; empty=")
assert(map_get(cookies, "session") == "abc123" and map_get(cookies, "theme") == "kali", "cookie_parse extracts cookie pairs")

std.io.progress("DOG 0.3.0", 3, 3)
std.io.table(["Mod", "Status"], [["std.io", "ok"], ["std.net", "ok"]])
clear()
var scratch: list<text> = ["a", "b"]
clear(scratch)
assert(len(scratch) == 0, "0-arg clear() clears screen while 1-arg clear(var) clears list")

define english_grade(score: number, bonus: number = 5) returns text
    let total = score + bonus
    if total is at least 90 then
        return "A"
    elif total is at least 80 then
        return "B"
    else if total is over 69 then
        return "C"
    else
        return "D"
    end
end

assert(english_grade(86) is "A", "define + returns + is at least + elif + default param works")
assert(english_grade(76) equals "B", "elif and equals work")
assert(english_grade(66) is equal to "C", "else if and is over work")
assert(english_grade(50) is not "A", "else and is not work")
assert(10 is greater than 5 and 2 is less than 4 and 4 is at most 4 and 3 is under 4, "all English comparisons work")
assert(7 is not equal to 8, "is not equal to works")

var counter = 0
set counter to 2
increase counter by 3
decrease counter by 1
assert(counter is 4, "set to, increase by, decrease by work")

until counter is at least 6
    increase counter by 1
end
assert(counter is 6, "until loop works")

unless counter is less than 6 then
    set counter to 10
else
    set counter to 0
end
assert(counter is 10, "unless ... then ... else ... end works")

var loops = 0
repeat 3 times
    increase loops by 1
end
assert(loops is 3, "repeat N times works")

var range_sum = 0
for n from 1 to 4
    increase range_sum by n
end
assert(range_sum is 10, "for n from 1 to 4 inclusive range works")

var joined_words = ""
for each w in ["hi", "dog"]
    joined_words += w
end
assert(joined_words is "hidog", "for each ... in ... works")

let match_word = 2
var match_out = ""
match match_word
    case 1
        set match_out to "one"
    else
        set match_out to "other"
end
assert(match_out is "other", "match ... else ... works")

let from = 1
let to = 2
let times = 3
let then = 4
assert(from + to + times + then is 10, "contextual English words remain usable as identifiers")
print("language_test English checks passed")
std.io.print("std.io.print works")

# Inline DOG CSS + Web DOM runtime checks
style theme
    --brand: "#2F6BFF"
end

style ".hero-card"
    bg: "#FFFFFF"
    pad: "18px"
    radius: "12px"
    on hover
        bg: "#F8FAFC"
    end
    on mobile
        pad: "12px"
    end
end

let card_css = css_bundle()
assert(contains(card_css, "--brand: #2F6BFF;"), "inline style theme registers CSS variables")
assert(contains(card_css, ".hero-card:hover {"), "inline style hover variant compiles cleanly")
assert(contains(card_css, "@media (max-width: 640px)"), "inline style mobile variant compiles cleanly")
dom_mount("#app", web_card("Hero", $"Built in DOG {web_button("hi-btn", "Say Hi")}"))
dom_add_class("#hi-btn", "active")
assert(not dom_toggle_class("#hi-btn", "active"), "dom_toggle_class returns false when toggled off")
